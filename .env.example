# Copy this file to .env and fill in values as needed.
# Nothing here is required to get Phase 1 running with LLM_PROVIDER=stub.

# --- Postgres (used by docker-compose.yml and the backend) ---
POSTGRES_USER=recruiting_agent
POSTGRES_PASSWORD=recruiting_agent
POSTGRES_DB=recruiting_agent
# NOTE: 5433, not the Postgres default 5432 -- deliberately avoids colliding with any
# Postgres you already run locally (e.g. via `brew services`). Change if 5433 is also taken.
POSTGRES_PORT=5433

# Full SQLAlchemy connection strings the backend actually uses.
# Host is `localhost` because the backend runs on the host, not inside docker-compose.
DATABASE_URL=postgresql+psycopg://recruiting_agent:recruiting_agent@localhost:5433/recruiting_agent
# Separate database used only by the test suite (created automatically by tests/conftest.py).
DATABASE_URL_TEST=postgresql+psycopg://recruiting_agent:recruiting_agent@localhost:5433/recruiting_agent_test

# --- App ---
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Resume storage ---
# Local filesystem directory (relative to backend/) where uploaded resumes are saved.
RESUME_STORAGE_DIR=data/resumes

# --- LLM provider ---
# One of: openai | anthropic | stub
# "stub" performs deterministic, no-network keyword/regex extraction -- useful for local dev
# and CI without any API key, but extraction quality is far below a real model.
LLM_PROVIDER=stub

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Search provider ---
# "duckduckgo" (default) needs no API key -- it uses DuckDuckGo's plain HTML results page, the
# same no-JS endpoint DuckDuckGo serves browsers with JavaScript disabled. Used by the Company
# Research Agent only as a fallback, when a company has no `website` on file: it searches for
# "<company name> official website", filters out known aggregators/social sites (LinkedIn,
# Crunchbase, Wikipedia, ...), and uses the first plausible result -- unverified, flagged as such
# in the run's warnings, until the fetched page itself is evidence-checked as usual.
# "stub" always returns no results (same role as LLM_PROVIDER=stub) -- set it for offline work
# or if you'd rather Company Research just skip companies with no website on file.
SEARCH_PROVIDER=duckduckgo

# --- Scheduler ---
# Off by default -- the app never makes background network calls (to HN/YC/GitHub) unless you
# turn this on. When true, re-runs discovery for every search profile on a fixed interval.
ENABLE_SCHEDULER=false
DISCOVERY_REFRESH_HOURS=6
